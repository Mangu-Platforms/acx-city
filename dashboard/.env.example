# ACX City — Dashboard (Next.js) environment
#
# Public base URL of the backend API. This is embedded in the client bundle at
# build time, so it must be a browser-reachable URL (NOT the Railway private
# domain). Leave blank only for local dev against a same-origin proxy.
#
# Production example (Railway-hosted backend):
#   NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
#
# Local dev example (Flask on :5000):
#   NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=
