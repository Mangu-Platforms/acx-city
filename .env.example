# Backend environment.
# With no .env at all, the app runs on SQLite with free Microsoft Edge voices.

# --- Database (system of record) --------------------------------------------
# Postgres in production; defaults to a local SQLite file if unset.
# Example: postgresql+psycopg://audiobook:audiobook@localhost:5432/audiobook
DATABASE_URL=
# Password used by the docker-compose Postgres service.
POSTGRES_PASSWORD=audiobook

# --- Auth -------------------------------------------------------------------
# AUTH_MODE selects the auth provider (see docs/adr/0001):
#   legacy   -> built-in bcrypt + JWT (email/password endpoints). Default.
#   supabase -> verify Supabase-issued JWTs; users provisioned just-in-time.
AUTH_MODE=legacy

# Legacy auth: REQUIRED in production. `openssl rand -hex 32`.
JWT_SECRET=
ACCESS_TOKEN_HOURS=12

# Supabase auth (only when AUTH_MODE=supabase). HS256 uses the project JWT secret;
# newer projects use asymmetric keys via JWKS instead.
SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated

# --- Object storage ---------------------------------------------------------
# STORAGE_BACKEND: local (default; dev/sandbox) or s3 (Supabase Storage / S3 / R2 / MinIO).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage_data
# Signed-download link lifetime (seconds).
SIGNED_URL_TTL_SECONDS=3600
# HMAC secret for local-backend signed URLs (falls back to JWT_SECRET).
STORAGE_SIGNING_SECRET=
# S3 / Supabase Storage settings (when STORAGE_BACKEND=s3):
# STORAGE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=audiobooks
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# Absolute base URL for local signed links behind a proxy (usually leave blank).
# PUBLIC_BASE_URL=

# --- Quotas & rate limiting -------------------------------------------------
# Monthly paid-synthesis quota in characters per org (0 = unlimited).
QUOTA_MONTHLY_CHARS=0
# Job-creation rate limit per org (requests per window).
SYNTHESIZE_RATE_LIMIT=30
SYNTHESIZE_RATE_WINDOW_SECONDS=60
# Rate limit backend: postgres (default) | upstash | none
RATE_LIMIT_BACKEND=postgres
# Upstash (when RATE_LIMIT_BACKEND=upstash):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Quality gating ---------------------------------------------------------
# off = never gate | warn = record warnings only (default) | block = hold failing jobs for review
QC_POLICY=warn

# --- Retention --------------------------------------------------------------
# Days to keep terminal jobs' audio before the sweeper deletes it (0 = forever).
RETENTION_DAYS=0
# Also delete the job rows (not just assets) when they expire.
RETENTION_DELETE_ROWS=false

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | text
# SENTRY_DSN=              # error monitoring (optional; requires sentry-sdk)
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- MCP server (AI-agent interface) -----------------------------------------
# Optional service (python mcp_server.py) exposing read-only platform tools
# (health, jobs, orgs, usage) to MCP clients over streamable HTTP at /mcp.
# Both vars are required for it to start.
MCP_ENABLED=false
# openssl rand -hex 32 — clients authenticate with "Authorization: Bearer <key>"
MCP_API_KEY=
# MCP_HOST=0.0.0.0
# MCP_PORT=8765           # Railway's injected PORT takes precedence

# --- Worker -----------------------------------------------------------------
WORKER_POLL_SECONDS=2
WORKER_ORPHAN_SWEEP_SECONDS=60
WORKER_RETENTION_SWEEP_SECONDS=3600

# AWS credentials: set these only if you want the AWS Polly provider enabled
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS allowlist (comma-separated origins). Defaults to the local dev frontend.
# Set to "*" ONLY for throwaway local testing — never in production.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Flask / server
# FLASK_ENV=development enables the dev server + debug when running `python app.py`.
# In containers we run gunicorn (see backend/Dockerfile), so leave this unset in prod.
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Storage locations (containers point these at a mounted volume).
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
CACHE_FOLDER=cache

# Frontend build/runtime: base URL for API calls. Leave empty to use same-origin "/api".
# VITE_API_BASE_URL=
